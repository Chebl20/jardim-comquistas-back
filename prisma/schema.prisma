model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  linkCode       String?  @unique // código para vincular com o bot
  telegramId     String?  @unique // id do usuário no Telegram
  timezone       String   @default("UTC") // IANA timezone, ex: 'America/Sao_Paulo'
  currentWorldId String? // mundo atual do usuário
  digestEnabled  Boolean  @default(false) // mensagem diária ativa
  digestTime     String? // "HH:MM" horário do resumo diário (timezone do usuário)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  goals                Goal[]
  userGoals            UserGoal[]
  conversationSessions ConversationSession[]
}

model World {
  id        String   @id @default(uuid())
  worldId   String   @unique // identifier like 'mundo2'
  name      String
  svgPath   String // relative path to SVG file
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config WorldConfig?
}

model Goal {
  id            String   @id @default(uuid())
  userId        String
  title         String
  description   String?
  conquestType  String // 'Corpo', 'Mente', 'Família', 'Trabalho', etc.
  goalKind      String // 'PONTUAL' | 'CONTINUA'
  status        String   @default("ACTIVE") // 'ACTIVE' | 'PAUSED' | 'ARCHIVED' | 'COMPLETED'
  plantedTreeId String?  @unique // FK opcional para PlantedTree (1:1)
  reminderTime  DateTime? // legado; compatibilidade com código existente
  scheduleConfig Json? // once.at=ISO; daily/weekly.times=HH:MM
  reminderSlotsToday Json? // [{ "time": "08:00" }] slots já enviados hoje (reset diário)
  lastReminderSentAt DateTime? // última vez que o lembrete foi enviado
  reminderCount      Int       @default(0) // quantas vezes o lembrete foi enviado
  dailyStatus        String? // PENDING | SENT | WAITING | DONE | SKIPPED
  silenceUntil       DateTime? // quando pode cobrar de novo
  completed          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plantedTree PlantedTree? @relation(fields: [plantedTreeId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  schedule    GoalSchedule?
  reminders   GoalReminder[]
  exceptions  GoalOccurrenceException[]

  @@index([userId, createdAt])
}

model GoalSchedule {
  id            String   @id @default(uuid())
  goalId        String   @unique // 1:1 com Goal
  frequency     String // 'ONCE' | 'DAILY' | 'WEEKLY' | 'MONTHLY'
  timeZone      String   @default("UTC") // IANA timezone
  dtStart       DateTime // início da série
  dtEnd         DateTime? // fim da série (opcional)
  rrule         String? // RFC 5545 recurrence rule string
  seriesEndDate DateTime? // data final da série (opcional)
  extra         Json? // configurações adicionais
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goal       Goal                      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  exceptions GoalOccurrenceException[]
}

model GoalOccurrenceException {
  id                     String   @id @default(uuid())
  goalId                 String
  scheduleId             String
  originalOccurrenceStart DateTime // timestamp original da ocorrência na série
  isCancelled            Boolean  @default(false)
  titleOverride          String?
  startOverride          DateTime?
  endOverride            DateTime?
  payloadOverride        Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  goal     Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  schedule GoalSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, originalOccurrenceStart])
}

model GoalReminder {
  id            String   @id @default(uuid())
  goalId        String
  minutesBefore Int      @default(0) // minutos antes da ocorrência para enviar lembrete
  createdAt     DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model UserGoal {
  id                   String    @id @default(uuid())
  userId               String
  title                String
  description          String?
  goalType             String // 'Pontual' ou 'Continua'
  conquestType         String // 'Corpo', 'Mente', 'Família', 'Trabalho', etc.
  frequency            Int? // legado; preferir scheduleConfig
  reminderTime         DateTime? // legado; preferir scheduleConfig
  scheduleConfig       Json? // once.at=ISO; daily/weekly.times=HH:MM
  reminderSlotsToday   Json? // [{ "time": "08:00" }] slots já enviados hoje (reset diário)
  lastReminderSentAt   DateTime? // última vez que o lembrete foi enviado
  reminderCount        Int       @default(0) // quantas vezes o lembrete foi enviado
  dailyStatus          String? // PENDING | SENT | WAITING | DONE | SKIPPED
  silenceUntil         DateTime? // quando pode cobrar de novo
  completed            Boolean   @default(false)
  plantedTreeId        String // ligação com a árvore que representa a meta
  anchorId             String // ligação direta com o anchor usado
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  plantedTree PlantedTree @relation(fields: [plantedTreeId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WorldConfig {
  id              Int      @id @default(autoincrement())
  worldId         String   @unique
  anchors         Json
  defaultTreeType String?
  defaultGrowth   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  world World? @relation(fields: [worldId], references: [worldId])
}

model TreeCatalog {
  id           String        @id @default(uuid())
  family       String
  type         String?
  stages       Json
  createdAt    DateTime      @default(now())
  plantedTrees PlantedTree[]

  @@unique([family, type])
}

model PlantedTree {
  id            String   @id @default(uuid())
  worldId       String
  anchorId      String
  treeCatalogId String
  actualStage   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  treeCatalog  TreeCatalog   @relation(fields: [treeCatalogId], references: [id])
  growthEvents GrowthEvent[]
  goal         Goal?         @relation
  userGoals    UserGoal[]
}

model GrowthEvent {
  id            String   @id @default(uuid())
  plantedTreeId String
  stage         Int
  progressIndex Int
  title         String
  description   String
  createdAt     DateTime @default(now())

  plantedTree PlantedTree @relation(fields: [plantedTreeId], references: [id])
}

model ConversationSession {
  id        String   @id @default(uuid())
  userId    String   @unique
  state     String
  payload   Json?
  version   Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
