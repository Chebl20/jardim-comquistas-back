generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  linkCode       String?  @unique // código para vincular com o bot
  telegramId     String?  @unique // id do usuário no Telegram
  timezone       String   @default("UTC") // IANA timezone, ex: 'America/Sao_Paulo'
  currentWorldId String? // mundo atual do usuário
  digestEnabled  Boolean  @default(false) // mensagem diária ativa
  digestTime     String? // "HH:MM" horário do resumo diário (timezone do usuário)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  goals                Goal[]
  conversationSessions ConversationSession[]
}

// ---------------------------------------------------------------------------
// Goal – meta do usuário (normalizada)
// ---------------------------------------------------------------------------
model Goal {
  id            String   @id @default(uuid())
  userId        String
  title         String
  description   String?
  conquestType  String // 'Corpo', 'Mente', 'Família', 'Trabalho', etc.
  goalKind      String // 'PONTUAL' | 'CONTINUA'
  status        String   @default("ACTIVE") // 'ACTIVE' | 'PAUSED' | 'ARCHIVED' | 'COMPLETED'
  plantedTreeId String?  @unique // FK opcional para PlantedTree (1:1)
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plantedTree PlantedTree?          @relation(fields: [plantedTreeId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])
  schedule    GoalSchedule?
  reminder    GoalReminder?
  exceptions  GoalOccurrenceException[]

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// GoalSchedule – frequência e horários do lembrete (1:1 com Goal)
// ---------------------------------------------------------------------------
model GoalSchedule {
  id          String    @id @default(uuid())
  goalId      String    @unique // 1:1 com Goal
  // Tipo de recorrência
  frequency   String // 'ONCE' | 'DAILY' | 'WEEKLY' | 'MONTHLY'
  // Para ONCE: data/hora exata do lembrete (UTC)
  at          DateTime?
  // Para DAILY / WEEKLY: horários no dia, ex: ["08:00", "18:00"]
  times       Json? // String[]
  // Para WEEKLY: dias da semana, ex: [1, 3, 5] (0=Dom, 1=Seg ... 6=Sab)
  daysOfWeek  Json? // number[]
  // Limitar duração (apenas DAILY): encerrar após N dias
  durationDays Int?
  // Timezone do usuário no momento da criação
  timeZone    String    @default("UTC")
  // Início/fim da série (opcional, para suporte a RFC 5545 futuro)
  dtStart     DateTime?
  dtEnd       DateTime?
  rrule       String? // RFC 5545 recurrence rule string
  extra       Json? // configurações adicionais
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goal       Goal                      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  exceptions GoalOccurrenceException[]
}

// ---------------------------------------------------------------------------
// GoalReminder – estado de dispatch do lembrete (1:1 com Goal)
// ---------------------------------------------------------------------------
model GoalReminder {
  id              String    @id @default(uuid())
  goalId          String    @unique // 1:1 com Goal
  // Estado atual do ciclo diário
  dailyStatus     String? // PENDING | SENT | WAITING_OPERATIONAL_REPLY | WAITING_FOLLOW_UP_REPLY | WAITING_REACTIVATION_REPLY | DONE | SKIPPED | MISSED | SNOOZED | DISMISSED | REACTIVATION_COOLDOWN
  // Slots já enviados hoje: [{ "time": "08:00" }]
  slotsToday      Json? // { time: string }[]
  // Última vez que o lembrete foi enviado
  lastSentAt      DateTime?
  // Quantas vezes o lembrete foi enviado (total)
  sentCount       Int       @default(0)
  // Silenciar até: quando pode cobrar novamente
  silenceUntil    DateTime?
  // Minutos antes da ocorrência para enviar (legado, compatibilidade)
  minutesBefore   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// GoalOccurrenceException – exceções / overrides de ocorrências na série
// ---------------------------------------------------------------------------
model GoalOccurrenceException {
  id                      String   @id @default(uuid())
  goalId                  String
  scheduleId              String
  originalOccurrenceStart DateTime // timestamp original da ocorrência na série
  isCancelled             Boolean  @default(false)
  titleOverride           String?
  startOverride           DateTime?
  endOverride             DateTime?
  payloadOverride         Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  goal     Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  schedule GoalSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, originalOccurrenceStart])
}

// ---------------------------------------------------------------------------
// World models
// ---------------------------------------------------------------------------
model World {
  id        String   @id @default(uuid())
  worldId   String   @unique // identifier like 'mundo2'
  name      String
  svgPath   String // relative path to SVG file
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config WorldConfig?
}

model WorldConfig {
  id              Int      @id @default(autoincrement())
  worldId         String   @unique
  anchors         Json
  defaultTreeType String?
  defaultGrowth   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  world World? @relation(fields: [worldId], references: [worldId])
}

model TreeCatalog {
  id           String        @id @default(uuid())
  family       String
  type         String?
  stages       Json
  createdAt    DateTime      @default(now())
  plantedTrees PlantedTree[]

  @@unique([family, type])
}

model PlantedTree {
  id            String   @id @default(uuid())
  worldId       String
  anchorId      String
  treeCatalogId String
  actualStage   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  treeCatalog  TreeCatalog   @relation(fields: [treeCatalogId], references: [id])
  growthEvents GrowthEvent[]
  goal         Goal?         @relation
}

model GrowthEvent {
  id            String   @id @default(uuid())
  plantedTreeId String
  stage         Int
  progressIndex Int
  title         String
  description   String
  createdAt     DateTime @default(now())

  plantedTree PlantedTree @relation(fields: [plantedTreeId], references: [id])
}

model ConversationSession {
  id        String   @id @default(uuid())
  userId    String   @unique
  state     String
  payload   Json?
  version   Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
